@model Tipset.ViewModels.HomeViewModel
@{
    ViewBag.Title = "Ställning";
    string posDir = (Model.SortColumn == "Position"    && Model.SortDir == "asc") ? "desc" : "asc";
    string fnDir  = (Model.SortColumn == "FirstName"   && Model.SortDir == "asc") ? "desc" : "asc";
    string lnDir  = (Model.SortColumn == "LastName"    && Model.SortDir == "asc") ? "desc" : "asc";
    string tpDir  = (Model.SortColumn == "TotalPoints" && Model.SortDir == "asc") ? "desc" : "asc";

    Func<string, string> arrow = col => Model.SortColumn == col
        ? (Model.SortDir == "asc" ? " ▲" : " ▼")
        : "";
}

@section head {
<style>
    /* Home-specific: constrain wrap width on this view only */
    #wrap { max-width: 700px; padding: 0 10px; }
</style>
}

<div id="wrap">
    @if (Model.EnableNewEntries)
    {
        <p>Här kommer den aktuella ställningen dyka upp när<br /> alla tipsrader är inlämnade.</p>
        <p>
            För att inte riskera att de du tippar försvinner om <br />överföringen av kupongen misslyckas,<br />
            rekommenderas att du laddar ner tipset som <a target="_blank" href="@Url.Content("~/Docs/tipset2026.pdf")">pdf</a><br />
            eller <a href="@Url.Content("~/Docs/tipset2026.xlsx")">excel</a> och tippar i lugn och ro,<br />
            för att sedan fylla i det du tippat här på sidan.
        </p>
        <p>
            Vill du lämna in en tipsrad följ länken nedan:<br />
            <a href="@Url.Content("~/NyKupong")">Fyll i en ny tipskupong</a>
        </p>
        <p>Lycka till!</p>
        <center><img src="@Url.Content("~/images/logo20262color.png")" alt="Manges VM-tips" height="400" /></center>
    }
    else
    {
        var homeUrl = Url.Action("Index", "Home");
        <p>Aktuell ställning vid datum:</p>
        <form action="@homeUrl" method="get">
            <select name="date" class="longdate" onchange="this.form.submit()">
                @foreach (var d in Model.StandingDates)
                {
                    <option value="@d.Guid" selected="@(d.Guid == Model.SelectedDate ? "selected" : null)">@d.UpdateDate.ToString("dd/MM HH:mm")</option>
                }
            </select>
            <input type="hidden" name="sort" value="@Model.SortColumn" />
            <input type="hidden" name="dir" value="@Model.SortDir" />
        </form>

        if (Model.Standings != null && Model.Standings.Any())
        {
            var urlPos = Url.Action("Index", "Home", new { date = Model.SelectedDate, sort = "Position", dir = posDir });
            var urlFn = Url.Action("Index", "Home", new { date = Model.SelectedDate, sort = "FirstName", dir = fnDir });
            var urlLn = Url.Action("Index", "Home", new { date = Model.SelectedDate, sort = "LastName", dir = lnDir });
            var urlTp = Url.Action("Index", "Home", new { date = Model.SelectedDate, sort = "TotalPoints", dir = tpDir });
            <div class="scroll-x">
                <table class="standings-table">
                    <thead>
                        <tr>
                            <th class="col-pos"><a href="@urlPos">Plats </a></th>
                            <th><a href="@urlFn">Förnamn </a></th>
                            <th><a href="@urlLn">Efternamn </a></th>
                            <th class="col-pts"><a href="@urlTp">Poäng </a></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Standings)
                        {
                            var detailUrl = Url.Action("Index", "Details", new { id = s.UserID });
                            <tr onclick="window.location='@detailUrl'">
                                <td class="col-pos">@s.Position</td>
                                <td>@s.User.FirstName</td>
                                <td>@s.User.LastName</td>
                                <td class="col-pts">@s.TotalPoints</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
