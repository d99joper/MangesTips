@model Tipset.ViewModels.DetailsViewModel

<div id="wrap">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p class="error">@Model.ErrorMessage</p>
    }

    
    <p>
        @Model.DisplayName <br />
        @if (Model.Position.HasValue)
        {
            <text>Nuvarande placering: @Model.Position<br /></text>
        }
        else
        {
            <text>Nuvarande placering: -<br /></text>
        }
        Totalpoäng: @Model.TotalPoints<br />
        @foreach (var yearHtml in Model.PreviousYearsHtml)
        {
            @Html.Raw(yearHtml)
        }
        Se ursprunglig tipsrad för utskrift (pdf): <a href="@Model.PdfUrl" target="_blank">PDF-fil</a>
    </p>

    1. Tipsraden
    <div class="scroll-x">
    <table class="matches-table">
        @foreach (var match in Model.UserMatches)
        {
            <tr>
                <td class="col-date">@match.Match.Date.ToString("d/M", new System.Globalization.CultureInfo("en-US"))</td>
                <td class="col-group">@match.Match.HomeTeam.GroupID</td>
                <td class="col-team">@match.Match.HomeTeam.TeamName</td>
                <td class="col-sep">-</td>
                <td class="col-team">@match.Match.AwayTeam.TeamName</td>
                <td class="col-score">@match.HomeGoals-@match.AwayGoals</td>
                <td class="col-points">@(match.Match.ResultMark != null ? string.Format("{0}p", match.Points) : "")</td>
            </tr>
        }
    </table>
    </div>

    <br /><br />
    <div class="editor-label">
        2. Vidare från gruppen
    </div>
    <div id="divPlayoffTeams" class="scroll-x">
        <table class="playoff">
            <thead>
                <tr>
                    <td>Grupp A @Model.GroupBonus["A"] </td>
                    <td>Grupp B @Model.GroupBonus["B"]</td>
                    <td>Grupp C @Model.GroupBonus["C"]</td>
                    <td>Grupp D @Model.GroupBonus["D"]</td>
                </tr>
            </thead>
            <tr>
                <td>1. @Model.PlayoffTeams["1A"]</td>
                <td>1. @Model.PlayoffTeams["1B"]</td>
                <td>1. @Model.PlayoffTeams["1C"]</td>
                <td>1. @Model.PlayoffTeams["1D"]</td>
            </tr>
            <tr>
                <td>2. @Model.PlayoffTeams["2A"]</td>
                <td>2. @Model.PlayoffTeams["2B"]</td>
                <td>2. @Model.PlayoffTeams["2C"]</td>
                <td>2. @Model.PlayoffTeams["2D"]</td>
            </tr>
            <tr><td>&nbsp;</td></tr>
            <tr>
                <td align="center">Grupp E @Model.GroupBonus["E"]</td>
                <td align="center">Grupp F @Model.GroupBonus["F"]</td>
                <td align="center">Grupp G @Model.GroupBonus["G"]</td>
                <td align="center">Grupp I @Model.GroupBonus["I"]</td>
            </tr>
            <tr>
                <td>1. @Model.PlayoffTeams["1E"]</td>
                <td>1. @Model.PlayoffTeams["1F"]</td>
                <td>1. @Model.PlayoffTeams["1G"]</td>
                <td>1. @Model.PlayoffTeams["1I"]</td>
            </tr>
            <tr>
                <td>2. @Model.PlayoffTeams["2E"]</td>
                <td>2. @Model.PlayoffTeams["2F"]</td>
                <td>2. @Model.PlayoffTeams["2G"]</td>
                <td>2. @Model.PlayoffTeams["2I"]</td>
            </tr>
        </table>
    </div>

    <br /><br />
    <div class="editor-label">
        3. Vilka lag går till kvartsfinal?
    </div>
    <div id="divQuarterFinalTeams" class="scroll-x">
        <table class="playoff">
            @foreach (var row in Model.QFRows)
            {
                <tr>
                    <td>@row[0]</td>
                    <td>@row[1]</td>
                </tr>
            }
        </table>
    </div>

    <br /><br />
    <div class="editor-label">
        4. Vilka lag går till semifinal?
    </div>
    <div id="div1" class="scroll-x">
        <table class="playoff">
            @foreach (var row in Model.SFRows)
            {
                <tr>
                    <td>@row[0]</td>
                    <td>@row[1]</td>
                </tr>
            }
        </table>
    </div>

    <br /><br />
    <div class="editor-label">
        5. Vilka lag går till final?
    </div>
    <div id="div2" class="scroll-x">
        <table class="playoff">
            <tr>
                @foreach (var team in Model.FinalTeams)
                {
                    <td>@team</td>
                }
            </tr>
        </table>
    </div>

    <br /><br />
    6. Skytteligan: @Model.TopScorer

    <br /><br />
    7. Brons: @Model.Bronze

    <br /><br />
    8. Silver: @Model.Silver

    <br /><br />
    9. Guld: @Model.Gold
</div>

