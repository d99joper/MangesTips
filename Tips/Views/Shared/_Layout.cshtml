@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment __env
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <link href="@Url.Content("~/CSS/Site.css")?v=@System.IO.File.GetLastWriteTime(System.IO.Path.Combine(__env.WebRootPath,"CSS","Site.css")).Ticks" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/CSS/EM2016.css")?v=@System.IO.File.GetLastWriteTime(System.IO.Path.Combine(__env.WebRootPath,"CSS","EM2016.css")).Ticks" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/CSS/responsive.css")?v=@System.IO.File.GetLastWriteTime(System.IO.Path.Combine(__env.WebRootPath,"CSS","responsive.css")).Ticks" rel="stylesheet" type="text/css" />
    <title>Manges VM-tips 2026</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=0.5, maximum-scale=5.0" />
    <meta property="og:title" content="Manges VM-tips" />
    <meta property="og:description" content="Det perfekta tillbehöret till fotbolls-VM. Inlägg, resultatlista och statistik på ett ställe." />
    <meta property="og:image" content="http://mangesvmtips2026.personablesolutions.com/images/oversloggamax2026.png" />
    @RenderSection("head", required: false)
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3C47RP4QYY"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-3C47RP4QYY');
    </script>
</head>
<body>
    <div class="page">
        <div id="header">
            <div id="title">
                <a href="@Url.Action("Index", "Home")"><img src="@Url.Content("~/images/oversloggamax2026.png")" alt="Manges VM-tips" /></a>
            </div>
            <div id="logindisplay">
                &nbsp;
            </div>
            <div id="menucontainer">
                @{ string currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString(); }
                <!-- Hidden checkbox used as toggle – no JavaScript needed -->
                <input type="checkbox" id="menu-toggle" />
                <label for="menu-toggle" id="menu-toggle-btn">&#9776; Meny</label>
                <ul id="menu">
                    <li class="@(currentController == "Home" ? "active" : "")"><a href="@Url.Action("Index", "Home")">Första sidan</a></li>
                    @if (!(bool)(ViewBag.EnableNewEntries ?? false))
                    {
                        <li class="@(currentController == "Statistics" ? "active" : "")"><a href="@Url.Action("Index", "Statistics")">Statistik</a></li>
                        <li class="@(currentController == "Answers" ? "active" : "")"><a href="@Url.Action("Index", "Answers")">Facit</a></li>
                    }
                    <li class="@(currentController == "Blog" ? "active" : "")"><a href="@Url.Action("Index", "Blog")">Blog</a></li>
                    @if ((bool)(ViewBag.EnableNewEntries ?? false))
                    {
                        <li class="@(currentController == "NyKupong" ? "active" : "")"><a href="@Url.Action("Index", "NyKupong")">Anmälan</a></li>
                    }
                    <li class="@(currentController == "Rules" ? "active" : "")"><a href="@Url.Action("Index", "Rules")">Regler</a></li>
                </ul>
            </div>
        </div>
        <div id="main">
            @RenderBody()
            <div id="footer">
            </div>
        </div>
    </div>
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-117542595-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'UA-117542595-1');
    </script>
</body>
</html>
